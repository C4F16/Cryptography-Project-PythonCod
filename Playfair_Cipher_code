import itertools
from collections import Counter

# =============================================
# ENGLISH LETTER FREQUENCIES (%)
# =============================================
ENGLISH_FREQ = {
    'E': 12.7, 'T': 9.1, 'A': 8.2, 'O': 7.5, 'I': 7.0,
    'N': 6.7,  'S': 6.3, 'H': 6.1, 'R': 6.0, 'D': 4.3,
    'L': 4.0,  'C': 2.8, 'U': 2.8, 'M': 2.4, 'W': 2.4,
    'F': 2.2,  'G': 2.0, 'Y': 2.0, 'P': 1.9, 'B': 1.5,
    'V': 1.0,  'K': 0.77,'J': 0.15,'X': 0.15,'Q': 0.1,
    'Z': 0.07
}

# =============================================
# BUILD PLAYFAIR GRID FROM KEYWORD
# =============================================
def build_grid(keyword):
   
    keyword = keyword.upper().replace('J', 'I')
    seen = set()
    key_chars = []

    # Add keyword letters first (no duplicates)
    for c in keyword:
        if c.isalpha() and c not in seen:
            seen.add(c)
            key_chars.append(c)

    # Fill remaining letters of the alphabet
    for c in 'ABCDEFGHIKLMNOPQRSTUVWXYZ':
        if c not in seen:
            seen.add(c)
            key_chars.append(c)

    # Build 5x5 grid
    grid = [key_chars[i*5:(i+1)*5] for i in range(5)]

    # Build position lookup
    pos = {}
    for r in range(5):
        for c in range(5):
            pos[grid[r][c]] = (r, c)

    return grid, pos


def print_grid(grid, keyword):
    print(f"\n  Playfair Grid (keyword = '{keyword}'):")
    print("  +" + "---+" * 5)
    for row in grid:
        print("  | " + " | ".join(row) + " |")
        print("  +" + "---+" * 5)


# =============================================
# DECRYPT A SINGLE DIGRAPH
# =============================================
def decrypt_digraph(a, b, grid, pos):
    
    a = a.replace('J', 'I')
    b = b.replace('J', 'I')
    ra, ca = pos[a]
    rb, cb = pos[b]

    if ra == rb:                          # Same row
        return grid[ra][(ca - 1) % 5] + grid[rb][(cb - 1) % 5]
    elif ca == cb:                        # Same column
        return grid[(ra - 1) % 5][ca] + grid[(rb - 1) % 5][cb]
    else:                                 # Rectangle
        return grid[ra][cb] + grid[rb][ca]


# =============================================
# DECRYPT FULL CIPHERTEXT
# =============================================
def playfair_decrypt(ciphertext, keyword):
    grid, pos = build_grid(keyword)
    plaintext = ''
    for i in range(0, len(ciphertext) - 1, 2):
        plaintext += decrypt_digraph(ciphertext[i], ciphertext[i+1], grid, pos)
    return plaintext


# =============================================
# SCORE PLAINTEXT (higher = more English-like)
# =============================================
def score_english(text):
    
    if not text:
        return 0
    freq = Counter(text)
    n = len(text)
    score = 0
    for c, cnt in freq.items():
        score += (cnt / n) * ENGLISH_FREQ.get(c, 0.01)
    return score


# =============================================
# FREQUENCY ANALYSIS REPORT
# =============================================
def frequency_analysis(ciphertext):
    print("\n" + "=" * 55)
    print("  FREQUENCY ANALYSIS")
    print("=" * 55)

    # Letter frequencies
    freq = Counter(ciphertext)
    total = len(ciphertext)
    print(f"\n  Letter frequencies (total = {total}):")
    print(f"  {'Letter':<8} {'Count':<8} {'%':<8}")
    print(f"  {'-'*24}")
    for letter, count in sorted(freq.items(), key=lambda x: -x[1]):
        bar = '#' * int(count / total * 100)
        print(f"  {letter:<8} {count:<8} {count/total*100:<6.1f}%  {bar}")

    # Top digraph frequencies
    digraphs = [ciphertext[i:i+2] for i in range(0, len(ciphertext)-1, 2)]
    dfreq = Counter(digraphs)
    print(f"\n  Top 10 digraphs:")
    print(f"  {'Digraph':<10} {'Count':<8}")
    print(f"  {'-'*18}")
    for dg, cnt in dfreq.most_common(10):
        print(f"  {dg:<10} {cnt}")


# =============================================
# BRUTE FORCE ATTACK
# =============================================
def brute_force(ciphertext, key_length=3, top_n=10):
    
    alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    total = len(alphabet) ** key_length
    results = []

    print(f"\n  Trying {total:,} keyword combinations (length = {key_length})...")

    for i, combo in enumerate(itertools.product(alphabet, repeat=key_length)):
        keyword = ''.join(combo)
        try:
            plain = playfair_decrypt(ciphertext, keyword)
            sc = score_english(plain)
            results.append((sc, keyword, plain))
        except Exception:
            pass

        # Progress every 5000
        if (i + 1) % 5000 == 0:
            pct = (i + 1) / total * 100
            print(f"    Progress: {i+1:,}/{total:,} ({pct:.0f}%)")

    results.sort(reverse=True)
    return results[:top_n]


# =============================================
# MAIN
# =============================================
def main():
    print("=" * 55)
    print("  Playfair Cipher Cryptanalysis")
    print("  CY 261 - Cryptography | Phase 1 Task 2")
    print("=" * 55)

    # Get ciphertext from user
    print("\nEnter the ciphertext (uppercase letters only):")
    ciphertext = input("> ").strip().upper().replace(" ", "").replace("\n", "")

    if len(ciphertext) == 0:
        print("Error: empty input.")
        return

    if len(ciphertext) % 2 != 0:
        print(f"Warning: ciphertext length {len(ciphertext)} is odd. Appending X.")
        ciphertext += 'X'

    print(f"\nCiphertext length: {len(ciphertext)} characters")
    print(f"Number of digraphs: {len(ciphertext)//2}")

    # Frequency analysis
    frequency_analysis(ciphertext)

    # Ask for key length
    print("\n" + "=" * 55)
    print("  BRUTE FORCE ATTACK")
    print("=" * 55)
    try:
        key_length = int(input("\nEnter key length to brute force [default = 3]: ").strip() or "3")
    except ValueError:
        key_length = 3

    # Run brute force
    top_results = brute_force(ciphertext, key_length=key_length, top_n=10)

    # Show top 10
    print(f"\n  Top 10 keyword candidates:")
    print(f"  {'Rank':<6} {'Keyword':<10} {'Score':<10} {'First 50 chars of plaintext'}")
    print(f"  {'-'*75}")
    for rank, (sc, kw, plain) in enumerate(top_results, 1):
        print(f"  {rank:<6} {kw:<10} {sc:<10.4f} {plain[:50]}")

    # Best result
    best_score, best_kw, best_plain = top_results[0]

    print("\n" + "=" * 55)
    print("  BEST RESULT")
    print("=" * 55)
    print(f"\n  Keyword      : {best_kw}")
    print(f"  Key length   : {key_length}")
    print(f"  Score        : {best_score:.4f}")

    # Print grid
    grid, _ = build_grid(best_kw)
    print_grid(grid, best_kw)

    # Print full plaintext
    print(f"\n  Full Plaintext ({len(best_plain)} characters):")
    print("  " + "-" * 65)
    for i in range(0, len(best_plain), 65):
        print("  " + best_plain[i:i+65])
    print("  " + "-" * 65)

    # Ask if user wants to try a different keyword manually
    print("\nWould you like to manually test a specific keyword? (y/n)")
    if input("> ").strip().lower() == 'y':
        manual_kw = input("Enter keyword: ").strip().upper()
        manual_plain = playfair_decrypt(ciphertext, manual_kw)
        manual_grid, _ = build_grid(manual_kw)
        print_grid(manual_grid, manual_kw)
        print(f"\n  Plaintext with keyword '{manual_kw}':")
        print("  " + "-" * 65)
        for i in range(0, len(manual_plain), 65):
            print("  " + manual_plain[i:i+65])
        print("  " + "-" * 65)

    print("\nDone.")


if __name__ == "__main__":
    main()
    
